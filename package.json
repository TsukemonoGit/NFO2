{
  "name": "nfo2-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@konemono/vitest-nostr": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vitest-websocket-mock": "^0.5.0"
  },
  "dependencies": {
    "@konemono/nostr-login": "^1.15.7",
    "@lucide/svelte": "^1.3.0",
    "@rx-nostr/crypto": "^3.1.6",
    "@tanstack/svelte-query": "^6.1.33",
    "bits-ui": "^2.18.1",
    "nip07-awaiter": "^1.1.0",
    "nostr-tools": "^2.23.5",
    "nostr-typedef": "^0.13.0",
    "rx-nostr": "^3.7.4"
  }
}
